# Optional. The assistant runs without these; they only enable the LLM-worded answer.
# Works with any provider that has an OpenAI-compatible API.

LLM_API_KEY=your-key-here
LLM_MODEL=model-name-here

# Leave out for OpenAI. For Google Gemini use:
# LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/

# Optional fallback if the online model fails: a model running on this computer.
# With Ollama installed and a model pulled, name it here (address defaults to Ollama's).
# LOCAL_LLM_MODEL=model-name-here
# LOCAL_LLM_BASE_URL=http://localhost:11434/v1
